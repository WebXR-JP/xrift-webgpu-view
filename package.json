{
  "name": "@webxr-jp/webgpu-view",
  "version": "0.2.0",
  "description": "Run a WebGPU scene in a Worker and show it in a React Three Fiber canvas (monitor and XR).",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "xrift",
    "webgpu",
    "webxr",
    "three",
    "react-three-fiber",
    "worker"
  ],
  "homepage": "https://github.com/WebXR-JP/xrift-webgpu-view#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebXR-JP/xrift-webgpu-view.git"
  },
  "bugs": {
    "url": "https://github.com/WebXR-JP/xrift-webgpu-view/issues"
  },
  "sideEffects": [
    "./dist/worker/index.js"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./experimental": {
      "types": "./dist/experimental/index.d.ts",
      "import": "./dist/experimental/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "example:dev": "npm run dev -w @webxr-jp/webgpu-view-example",
    "example:build": "npm run build -w @webxr-jp/webgpu-view-example",
    "example:typecheck": "npm run typecheck -w @webxr-jp/webgpu-view-example",
    "example:upload": "npm run upload -w @webxr-jp/webgpu-view-example",
    "check": "npm run typecheck && npm run build && npm run example:typecheck && npm run example:build"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=9",
    "react": ">=19",
    "three": ">=0.183"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.5.0",
    "@types/react": "^19.2.14",
    "@types/three": "^0.183.1",
    "@webgpu/types": "^0.1.66",
    "react": "~19.2.4",
    "three": "^0.183.1",
    "typescript": "^5.6.2",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "examples/*"
  ]
}
